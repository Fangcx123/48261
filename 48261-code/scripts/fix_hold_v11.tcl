source [file join [file dirname [info script]] paths.tcl]
# Repair hold timing on the database generated by build_v11.tcl.
require_file $routed_db
cd $run_dir
import_device eagle_s20.db -package EG4S20BG256
import_db $routed_db
fix_hold -eco
update_timing -mode final
report_timing_summary -file [file join $output_dir hold_timing.rpt]
export_db $repaired_db
require_file $repaired_db
puts "PACKAGE_HOLD_OK"
exit
